@model IEnumerable<SistemaTriage.Web.Controllers.UsuarioConRolesViewModel>

@{
    ViewData["Title"] = "Gestión de Usuarios y Roles";
}

<div class="container mt-4">
    <h2>Gestión de Usuarios y Roles</h2>
    <hr />

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Correo Electrónico</th>
                <th>Roles Actuales</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>
                        @if (user.Roles.Any())
                        {
                            <span class="badge bg-primary">@string.Join(", ", user.Roles)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Sin roles</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditRoles" asp-route-id="@user.UserId" class="btn btn-sm btn-warning">Editar Roles</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver al Inicio</a>
</div>